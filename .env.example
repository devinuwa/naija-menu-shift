# No external API key is required for the working prototype.
# Do NOT commit credentials, private restaurant information, or personal data.
# --- MenuShift AI planner (append these lines to .env.example) -----------------
# The planner is OPTIONAL. With nothing set, the app runs fully offline in
# local mode: a deterministic proposer driven by the local explorer.
# No API keys belong in this file or in git. In the AWS sandbox, boto3 reads
# credentials from the workshop session itself (SDK credential chain).

# Planner mode: "local" (default, offline) or "bedrock" (AWS sandbox only).
MENUSHIFT_AI_MODE=local

# Bedrock model ID or inference profile ID to call when MENUSHIFT_AI_MODE=bedrock.
# Must be a model the organisers enabled for the event in us-east-1; copy it
# exactly from the Bedrock console. Leave unset in local mode.
# BEDROCK_MODEL_ID=

# AWS region. The workshop sandbox and its model allowlist exist ONLY in
# us-east-1; the config loader rejects any other region. Normally leave unset.
# AWS_REGION=us-east-1

# Maximum planner rounds for the agent loop. Hard cap is 2 (agent contract).
# MENUSHIFT_AI_MAX_ROUNDS=2
# --- end of AI planner additions ----------------------------------------------
