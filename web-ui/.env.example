# Naija MenuShift web UI — environment variables
#
# MENUSHIFT_ENGINE_URL
#   Leave EMPTY (or unset) to use the built-in local TypeScript engine in
#   app/api/explore/route.ts — this is the demo mode that works offline.
#
#   Tomorrow, when the Python engine is hosted on AWS (e.g. API Gateway +
#   Lambda, ECS, or App Runner exposing POST /explore with the same JSON
#   contract), set this to that base URL. The API route will then proxy
#   every brief to the AWS engine. NO UI code changes are needed.
#
#   Example: MENUSHIFT_ENGINE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod
MENUSHIFT_ENGINE_URL=

# Standard Next.js port for local production runs (optional).
# PORT=3000
